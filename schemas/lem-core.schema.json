{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/lem/1.0/schema/core",
  "$comment": "Copyright 2026 Piotr Augustyniak. SPDX-License-Identifier: Apache-2.0",
  "title": "LEM 1.0 core location",
  "type": "object",
  "properties": {
    "site": { "type": "string", "minLength": 1, "maxLength": 256 },
    "building": { "type": "string", "minLength": 1, "maxLength": 256 },
    "level": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "numeric" },
            "value": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "non-building" },
            "value": { "type": "null" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        }
      ]
    },
    "referenceSpace": { "type": "string", "minLength": 1, "maxLength": 256 },
    "relativePosition": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "additionalProperties": true,
  "anyOf": [
    { "required": ["site"] },
    { "required": ["building"] },
    { "required": ["level"] },
    { "required": ["referenceSpace"] },
    { "required": ["relativePosition"] }
  ],
  "dependentRequired": {
    "relativePosition": ["referenceSpace"]
  }
}
